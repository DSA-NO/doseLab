file(MAKE_DIRECTORY "${TEST_DIR}")
file(WRITE "${TEST_DIR}/run.mac"
  "/run/initialize\n/random/setSeeds 12345 67890\n/gps/particle gamma\n/gps/energy 1 MeV\n/run/beamOn 40\n")

set(modes Serial)
if(MT_ENABLED)
  list(APPEND modes MT)
endif()
foreach(mode IN LISTS modes)
  set(thread_args)
  if(mode STREQUAL "MT")
    set(thread_args -t 2)
  endif()
  execute_process(
    COMMAND "${CMAKE_COMMAND}" -E env "G4RUN_MANAGER_TYPE=${mode}" "LAB_OUTPUT_DIR=${TEST_DIR}/output"
            "${APP}" ${thread_args} -b "${TEST_DIR}/run.mac"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "${mode} run failed (${result}):\n${output}\n${error}")
  endif()
  set(rows 1)
  if(mode STREQUAL "MT")
    set(rows 2)
  endif()
  string(REGEX MATCH "Output path: ([^\r\n]+)" path_line "${output}")
  set(output_file "${CMAKE_MATCH_1}")
  if(NOT path_line OR NOT EXISTS "${output_file}")
    message(FATAL_ERROR "${mode} run did not create its reported output file:\n${output}")
  endif()
  string(FIND "${output_file}" "${TEST_DIR}/output/" prefix)
  if(NOT prefix EQUAL 0 OR output_file STREQUAL previous_output)
    message(FATAL_ERROR "${mode} run did not use a unique directory under the configured output root")
  endif()
  set(previous_output "${output_file}")
  execute_process(COMMAND "${READER}" "${output_file}" "${rows}"
                  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "${mode} random state verification failed:\n${output}\n${error}")
  endif()
endforeach()
