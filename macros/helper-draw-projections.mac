# Return to visualization-friendly settings and draw dose projections.

/tracking/storeTrajectory 1
/vis/viewer/set/autoRefresh false

# Draw XY projections.
/score/drawProjection waterPlane dose defaultLinearColorMap 100
/score/drawProjection chamberPlane dose defaultLinearColorMap 100

/vis/viewer/set/autoRefresh true
/vis/viewer/refresh
/vis/viewer/update
