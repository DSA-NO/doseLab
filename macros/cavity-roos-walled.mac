# Standard Roos-like walled cavity preset for doseLab.
# Use before /run/initialize in batch or visualization macros.

/doseLab/scenario/type roos-walled
/doseLab/geometry/material G4_AIR
/doseLab/geometry/wallMaterial G4_PLEXIGLASS
# Water test override (both cavity and wall):
# /doseLab/geometry/material G4_WATER
# /doseLab/geometry/wallMaterial G4_WATER
/doseLab/geometry/print
